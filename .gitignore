# ---------------------------------------------------------------- secrets
# WiFi password, bot token and chat id live here. Never commit.
_secrets/secrets.h
**/secrets.h
!**/secrets.example.h

# ------------------------------------------------- PlatformIO build output
# firmware.bin / .elf / .o contain the compiled-in secrets (strings from
# secrets.h end up in the image), so the whole build tree stays out of git.
.pio/
**/.pio/

# ------------------------------------------------------------ editor noise
.vscode/
.idea/
*.swp
*~
.DS_Store

# ------------------------------------------------- android build (project 10)
# SDK path is machine-specific; build trees + gradle cache stay local.
10ESPPhoneComms/android/local.properties
10ESPPhoneComms/android/.gradle/
10ESPPhoneComms/android/build/
10ESPPhoneComms/android/app/build/

